# Public reads work without these. Writes (register, propose, veto, settle)
# need the demo testnet keys created by `npm run seed`. Never commit real values.
# Copy to .env.local. Next.js loads .env.local automatically. Restart `npm run dev` after seeding.

NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
CONTRACT_ID=plock03ae.testnet

# Payee accounts. propose and register sign with these keys.
# The demo's "attacker" step uses the payee key on purpose: that is a stolen owner key.
ACME_ACCOUNT_ID=acme.plock03ae.testnet
ACME_PRIVATE_KEY=ed25519:replace-me
GLOBEX_ACCOUNT_ID=globex.plock03ae.testnet
GLOBEX_PRIVATE_KEY=ed25519:replace-me
INITECH_ACCOUNT_ID=initech.plock03ae.testnet
INITECH_PRIVATE_KEY=ed25519:replace-me

# Guardian. veto signs with this key. The payee cannot rotate or remove it.
GUARDIAN_ACCOUNT_ID=guardian.plock03ae.testnet
GUARDIAN_PRIVATE_KEY=ed25519:replace-me

# Optional. Authenticated Intents quotes use a lower fee. Dry quotes work without it.
# Register at https://partners.near-intents.org
INTENTS_API_URL=https://1click.chaindefuser.com
INTENTS_JWT=

# Optional override for the agent example:
# PAYEE_LOCK_URL=http://localhost:3000
